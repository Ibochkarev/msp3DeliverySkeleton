{
    "name": "ibochkarev/msp3-delivery-skeleton",
    "description": "Reusable skeleton for MiniShop3 delivery extras",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "Ibochkarev\\Msp3DeliverySkeleton\\": "core/components/msp3deliveryskeleton/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibochkarev\\Msp3DeliverySkeleton\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    }
}
